From 801f9bf3b4ff7a6b9fe7325afe20ec605ab6f115 Mon Sep 17 00:00:00 2001
From: yinvoker <redacted@example.invalid>
Date: Mon, 31 Aug 2026 22:30:18 +0800
Subject: [PATCH] perf: restore ruy SDOT kernels lost in bazel_to_cmake conversion

Vendor-only excerpt of the original commit. Obsolete Kotlin SDK and benchmark
app hunks are omitted; those first-party files are maintained in project history.

Restore the ARM DotProd compile flags lost in the upstream Bazel-to-CMake conversion.

---
 engine/marian-fork/src/3rd_party/CMakeLists.txt |   10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/engine/marian-fork/src/3rd_party/CMakeLists.txt b/engine/marian-fork/src/3rd_party/CMakeLists.txt
index aca63ef..566de41 100644
--- a/engine/marian-fork/src/3rd_party/CMakeLists.txt
+++ b/engine/marian-fork/src/3rd_party/CMakeLists.txt
@@ -24,6 +24,16 @@ if(USE_RUY)
   set(CPUINFO_BUILD_TOOLS      OFF CACHE BOOL " " FORCE)
   add_subdirectory(ruy/third_party/cpuinfo EXCLUDE_FROM_ALL)
   add_subdirectory(ruy EXCLUDE_FROM_ALL)
+  # Upstream Bazel builds ruy's arm kernel/pack files with 8.2+dotprod so the
+  # SDOT kernels exist behind runtime dispatch; the bazel_to_cmake conversion
+  # dropped those per-target copts, silently compiling the fast int8 path OUT.
+  if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
+    foreach(ruy_arm_target ruy_kernel_arm ruy_pack_arm)
+      if(TARGET ${ruy_arm_target})
+        target_compile_options(${ruy_arm_target} PRIVATE -march=armv8.2-a+dotprod)
+      endif()
+    endforeach()
+  endif()
 endif(USE_RUY)
 
 if(USE_ONNX_SGEMM)
