@@ -53,7 +64,7 @@ void getYamlFromModel(YAML::Node& yaml,
                       const void* ptr) {
   auto item = binary::getItem(ptr, varName);
   if(item.size() > 0)
-    yaml = YAML::Load(item.data());
+    yaml = YAML::Load(boundedYaml(item));
 }

 // Load YAML from item
