From 448b55aad849b8f8bb2f061f627eaab74722ef31 Mon Sep 17 00:00:00 2001
From: yinvoker <yinvoker@outlook.com>
Date: Tue, 1 Sep 2026 13:59:06 +0800
Subject: [PATCH] patch: AsyncService::Config.onWorkerStart hook for
 worker-thread setup

Optional callback run first thing on each worker thread with its id.
Lets the embedder do platform-specific thread setup (CPU affinity,
priority) without the engine knowing about any platform. Exceptions are
swallowed so a failing hook can never take a worker down.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 engine/src/translator/service.cpp | 7 +++++++
 engine/src/translator/service.h   | 5 +++++
 2 files changed, 12 insertions(+)

diff --git a/engine/src/translator/service.cpp b/engine/src/translator/service.cpp
index 32cd023..b4c95ed 100644
--- a/engine/src/translator/service.cpp
+++ b/engine/src/translator/service.cpp
@@ -139,6 +139,13 @@ AsyncService::AsyncService(const AsyncService::Config &config)
   workers_.reserve(config_.numWorkers);
   for (size_t cpuId = 0; cpuId < config_.numWorkers; cpuId++) {
     workers_.emplace_back([cpuId, this] {
+      if (config_.onWorkerStart) {
+        try {
+          config_.onWorkerStart(cpuId);
+        } catch (...) {
+          // Thread-setup hooks are best-effort; never take a worker down.
+        }
+      }
       // Consumer thread main-loop. Note that this is an infinite-loop unless the monitor is explicitly told to
       // shutdown, which happens in the destructor for this class.
       Batch batch;
diff --git a/engine/src/translator/service.h b/engine/src/translator/service.h
index 1e4c9ba..7706129 100644
--- a/engine/src/translator/service.h
+++ b/engine/src/translator/service.h
@@ -1,6 +1,7 @@
 #ifndef SRC_BERGAMOT_SERVICE_H_
 #define SRC_BERGAMOT_SERVICE_H_
 
+#include <functional>
 #include <queue>
 #include <thread>
 #include <vector>
@@ -111,6 +112,10 @@ class AsyncService {
     size_t numWorkers{1};   ///< How many worker translation threads to spawn.
     size_t cacheSize{0};    ///< Size in History items to be stored in the cache. Loosely corresponds to sentences to
                             /// cache in the real world. A value of 0 means no caching.
+    /// Optional hook run first thing on each worker thread, with the worker id in [0, numWorkers). Intended for
+    /// platform-specific thread setup (CPU affinity, priority). Exceptions are swallowed so a failing hook can never
+    /// take a worker down.
+    std::function<void(size_t)> onWorkerStart{nullptr};
     Logger::Config logger;  // Configurations for logging
 
     template <class App>
-- 
